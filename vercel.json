{
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/youtube-kit.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/team(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/opening(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/vault(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(login|register|dashboard|checkout|course|certificate|quiz|forgot-password).html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    { "source": "/ai-ads", "destination": "/ai-studio", "permanent": true },
    { "source": "/ai-ads.html", "destination": "/ai-studio", "permanent": true }
  ],
  "rewrites": [
    { "source": "/ai-studio", "destination": "/ai-studio.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/team",  "destination": "/team/index.html" },
    { "source": "/opening", "destination": "/opening.html" },
    { "source": "/vault", "destination": "/vault/index.html" },
    { "source": "/vault/tools/:page", "destination": "/vault/tools/:page.html" }
  ]
}
